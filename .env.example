# LEVARO configuration template
# Copy to an untracked environment-specific file and replace placeholders.
# Never commit real credentials, encryption keys, OAuth tokens, or customer data.

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth.js
# Generate a high-entropy secret for each environment. Do not reuse it as any
# other application or encryption key.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=false

# Authentication provider credentials (provider selection is not yet decided).
# Add only the variables required by the approved Auth.js provider; do not
# expose client secrets through NEXT_PUBLIC_* variables.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# PostgreSQL / Neon
# Require TLS for hosted Neon connections (for example, sslmode=require).
# Use a restricted runtime role here and a separately authorized migration role.
DATABASE_URL=postgresql+psycopg://levaro_runtime:replace-me@localhost:5432/levaro
MIGRATION_DATABASE_URL=postgresql+psycopg://levaro_migrator:replace-me@localhost:5432/levaro

# Redis / Celery
# Use rediss:// plus verified TLS configuration for hosted environments.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# OAuth token encryption
# Supply an application-layer authenticated-encryption key generated with the
# approved crypto library. Keep old keys available during controlled rotation.
OAUTH_TOKEN_ENCRYPTION_KEY_VERSION=v1
OAUTH_TOKEN_ENCRYPTION_KEY_V1=replace-with-library-generated-key-material

# OpenAI (not connected until a real request is successfully verified)
OPENAI_API_KEY=replace-with-an-approved-project-key
OPENAI_MODEL=replace-with-an-approved-model-id
OPENAI_REQUEST_TIMEOUT_SECONDS=30

# Provider integrations
# No CRM or messaging provider has been selected. Add provider-specific client
# IDs, client secrets, webhook secrets, and redirect URIs only when that
# integration phase is authorized. A configured value does not mean connected.
# PROVIDER_CLIENT_ID=
# PROVIDER_CLIENT_SECRET=
# PROVIDER_REDIRECT_URI=
# PROVIDER_WEBHOOK_SECRET=

# Operational safeguards
# Outbound delivery remains disabled until the approval workflow and a real
# provider are implemented and verified. Production code must fail closed.
OUTBOUND_MESSAGING_ENABLED=false

